# Environment Configuration for Zarbin Backend
# Copy this to .env and fill in actual values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Rails
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true

# API Configuration
API_HOST=localhost:3000
API_PORT=3000

# Flutter Client Configuration
FLUTTER_APP_API_BASE_URL=http://localhost:3000/api/v1

# Authentication
JWT_SECRET=your_super_secret_jwt_key_generate_with_$(openssl rand -hex 32)
JWT_EXPIRY_HOURS=168

# SMS OTP Service (Kavenegar)
KAVENEGAR_API_KEY=your_kavenegar_api_key
KAVENEGAR_SENDER=Zarbin
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Market Data Service (TGJU)
TGJU_API_BASE_URL=https://api.tgju.org/v1
TGJU_API_TIMEOUT=10

# Solid Queue Configuration
SOLID_QUEUE_POLLING_INTERVAL=1

# Logging
LOG_LEVEL=debug

# Timezone
TZ=Asia/Tehran

# Feature Flags (optional)
ENABLE_MARKET_RATE_CACHING=true
ENABLE_TRANSACTION_SYNC=true
